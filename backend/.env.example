# ─────────────────────────────────────────────────────────
# SatQuery AI — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────
SATQUERY_ENV=development
SATQUERY_RUN_DIR=runs/api
SATQUERY_LOG_LEVEL=INFO
ROUTER_MODE=fallback
ROUTER_LLM_MODEL_ID=Qwen/Qwen3-4B
ROUTER_LLM_DEVICE=auto
ROUTER_LLM_MAX_TOKENS=2048
ROUTER_LLM_TEMPERATURE=0.1
RESOURCE_LIMIT_CPU=8
RESOURCE_LIMIT_LOCAL_GPU_LIGHT=1
RESOURCE_LIMIT_REMOTE_API=4
HF_TOKEN=hf_xxxxxxxxx
HF_INFERENCE_BASE_URL=https://router.huggingface.co/v1/chat/completions
VLM_SERVERLESS_MODEL_ID=Qwen/Qwen2.5-VL-72B-Instruct
VLM_MAX_TOKENS=512
VLM_TEMPERATURE=0.2
DUAL_ENCODER_ENABLED=true
DUAL_ENCODER_DEVICE=auto
CROMA_ENABLED=true
CROMA_MODEL_PATH=backend/models/croma/CROMA_base.pt
CROMA_DEVICE=auto
REMOTECLIP_ENABLED=true
REMOTECLIP_MODEL_PATH=backend/models/remoteclip/RemoteCLIP-ViT-B-32.pt
REMOTECLIP_DEVICE=auto
RSLLAVA_ENABLED=true
RSLLAVA_MODEL_ID=BigData-KSU/RS-llava-v1.5-7b-LoRA
RSLLAVA_MODEL_BASE=Intel/neural-chat-7b-v3-3
RSLLAVA_ENDPOINT=
TEOCHAT_ENABLED=true
TEOCHAT_MODEL_ID=jirvin16/TEOChat
TEOCHAT_SPACE_ID=
TEOCHAT_ENDPOINT=
SEGEARTH_ENABLED=false
SEGEARTH_MODEL_ID=Dingyi111/SegEarth-OV
SEGEARTH_ENDPOINT=
SARCLIP_ENABLED=false
SARCLIP_MODEL_ID=BiliSakura/SARCLIP-ViT-L-14
SARCLIP_ENDPOINT=
